# ─────────────────────────────────────────────
#  ServiceNow MCP — Configuração de ambiente
# ─────────────────────────────────────────────

# URL da instância ServiceNow (obrigatório)
SN_INSTANCE=https://seu-dominio.service-now.com

# ── Modo de autenticação ──────────────────────
# Valores: basic (padrão) | oauth
SN_AUTH=basic

# ── Basic Auth ────────────────────────────────
# Necessário quando SN_AUTH=basic
SN_USER=admin
SN_PASSWORD=sua-senha-aqui

# ── OAuth 2.0 ─────────────────────────────────
# Necessário quando SN_AUTH=oauth
# Configure um OAuth Application no ServiceNow:
#   System OAuth → Application Registry → New → Create an OAuth API endpoint for external clients
#
# Grant type: password (padrão) | client_credentials
SN_GRANT_TYPE=password
SN_CLIENT_ID=seu-client-id-aqui
SN_CLIENT_SECRET=seu-client-secret-aqui
#
# Necessário apenas para SN_GRANT_TYPE=password:
# SN_USER=seu-usuario
# SN_PASSWORD=sua-senha

# ── Múltiplas instâncias (opcional) ───────────
# Prefixe as variáveis com o nome do ambiente.
# A IA conectará na instância correta ao informar "env": "DEV".
# DEV_SN_INSTANCE=https://dev-dominio.service-now.com
# DEV_SN_USER=admin
# DEV_SN_PASSWORD=senha_dev

# TEST_SN_INSTANCE=https://test-dominio.service-now.com
# TEST_SN_USER=admin
# TEST_SN_PASSWORD=senha_test
