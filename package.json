{
  "name": "servicenow-mcp-server",
  "version": "7.0.0",
  "description": "MCP Server para desenvolvimento no ServiceNow via Claude, VS Code e Google Agentspace",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dashboard": "tsx src/dashboard/server.ts",
    "dev": "tsx --watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit",
    "add-tool": "tsx scripts/add-tool.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "servicenow",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffersonrmoraes/servicenow-mcp.git"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
